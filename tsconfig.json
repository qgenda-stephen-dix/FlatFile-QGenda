{
  "compilerOptions": {
    "target": "ES2020",
    "allowJs": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "ES2021.String",
      "DOM",
      "ES2015",
      "dom.asynciterable"
    ],
    "module": "commonjs",
    "outDir": "./dist",
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "baseUrl": ".",
    "paths": {
      "@flatfile/listener": ["node_modules/@flatfile/listener"]
    }
  },
  "exclude": [
    "node_modules",
    "jest.config.js",
    "lib",
    "cli-utils",
    ".git"
  ]
}